# Public API base URLs inlined into the client bundle by Next.js.
# Copy to `.env.local` and adjust; `.env.local` is git-ignored.
NEXT_PUBLIC_VACANCIES_MARKET_API_URL=http://localhost:8001/api/v1
# ResearcherCrm serves `GET /jobs` for the desired-jobs bar.
NEXT_PUBLIC_RESEARCHER_CRM_API_URL=http://localhost:8002/api/v1

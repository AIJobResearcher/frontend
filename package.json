{
  "name": "aijobresearcher-frontend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "next build",
    "start": "next start -p 3005",
    "prebuild": "npm run docs:sync",
    "docs:sync": "node scripts/sync-docs.mjs",
    "lint": "oxlint . --fix",
    "lint:check": "oxlint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,scss}\"",
    "prepare": "husky",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:run": "jest --ci",
    "type-check": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "api:types": "npx -y -p typescript@5.9.3 -p openapi-typescript@7.13.0 openapi-typescript docs/api/vacancies-market/openapi.yaml -o src/shared/api/generated/vacancies-market.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.8",
    "next": "16.3.5",
    "next-intl": "4.14.5",
    "openapi-fetch": "0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/jest": "30.0.0",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "babel-plugin-react-compiler": "1.0.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "lint-staged": "15.5.2",
    "oxlint": "1.83.0",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
